# ==============================================================================
# GRICC – GLOBAL RISK INTELLIGENCE COMMAND CENTRE
# Environment Variables & Live Provider Configuration Template
# ==============================================================================

# Server & Network Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
# Comma-separated production CORS allowlist (required in NODE_ENV=production, e.g. https://gricc.example.com)
CORS_ORIGIN=
TRUST_PROXY=false

# SQLite Database & Backup Configuration (stored outside build directories)
DB_PATH=./server/data/gricc.db
BACKUP_DIR=./server/backups
BACKUP_RETENTION_COUNT=14

# Authentication & JWT Security (Phase 8)
# IMPORTANT: Set a strong random secret in .env for production
JWT_SECRET=replace-with-a-strong-64-char-random-secret
JWT_EXPIRES_IN=8h

# Telemetry Cache TTL (in seconds)
# Prevents excessive repeated requests and respects provider rate limits
DATA_CACHE_TTL_SECONDS=60

# ==============================================================================
# LIVE INTELLIGENCE PROVIDERS (OPTIONAL)
#
# NOTE: By default, GRICC connects to zero-key public authoritative feeds:
#   - Natural Disasters: NASA EONET v3 Public Planetary API
#   - Cybersecurity: US CISA Known Exploited Vulnerabilities (KEV) Catalog
#   - Weather Emergencies: US National Weather Service (NWS) Active Warning API
#   - Geopolitical Risk: UN OCHA ReliefWeb Crisis Reports API
#   - International News: GDELT 2.0 Global Intelligence Document API
#
# If you wish to plug in commercial or private enterprise providers, configure
# the appropriate credentials below. If left blank, GRICC safely operates using
# the public feeds or curated standby demo telemetry.
# ==============================================================================

# 1. International News Provider (e.g. NewsAPI, MediaStack, or GDELT)
NEWS_API_PROVIDER=
NEWS_API_KEY=
NEWS_API_ENDPOINT=

# 2. Geopolitical Risk Provider (e.g. ACLED, CrisisGroup, or ReliefWeb)
GEOPOLITICAL_API_PROVIDER=
GEOPOLITICAL_API_KEY=
GEOPOLITICAL_API_ENDPOINT=

# 3. Natural Disaster Monitoring (e.g. NASA EONET, GDACS, USGS)
DISASTER_API_PROVIDER=
DISASTER_API_KEY=
DISASTER_API_ENDPOINT=

# 4. Severe Weather Warnings (e.g. NOAA / NWS, OpenWeather)
WEATHER_API_PROVIDER=
WEATHER_API_KEY=
WEATHER_API_ENDPOINT=

# 5. Cybersecurity Threat Intelligence (e.g. CISA KEV, AlienVault OTX, NVD)
CYBER_THREAT_API_PROVIDER=
CYBER_THREAT_API_KEY=

# ==============================================================================
# PHASE 15: AI-POWERED INTELLIGENCE ASSISTANT (OPTIONAL EXTERNAL PROVIDER)
#
# AI_PROVIDER: gricc-deterministic (default, zero-key grounded synthesis) |
#              gemini | openai | anthropic
# Never expose AI_API_KEY to the frontend.
# ==============================================================================
AI_PROVIDER=gricc-deterministic
AI_API_KEY=
AI_MODEL=grounded-retrieval-v1
AI_TIMEOUT_MS=12000
AI_MAX_RETRIES=2
CYBER_THREAT_API_ENDPOINT=
